# Data files (licensed / too large for git)
data/*.parquet
data/*.csv
data/*.txt
data/*.zip
!data/.gitkeep

# Output artefacts (regenerated by scripts)
outputs/tables/*.csv
outputs/tables/*.tex
outputs/figures/*.png
outputs/figures/*.pdf
!outputs/tables/.gitkeep
!outputs/figures/.gitkeep

results/survivorship_free/*.txt
results/revision/*.txt
!results/survivorship_free/.gitkeep
!results/revision/.gitkeep

# Python
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
.env

# macOS
.DS_Store
